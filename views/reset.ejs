<%- include('partials/head') %>
<section class="narrow">
  <h1>Choose a new password</h1>
  <% if (!valid) { %>
    <div class="flash flash-error" role="alert">This reset link is invalid or has expired.</div>
    <p><a class="btn btn-primary" href="/forgot">Request a new link</a></p>
  <% } else { %>
    <%- include('partials/errors', { errors }) %>
    <form method="post" action="/reset/<%= token %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>New password <input type="password" name="password" autocomplete="new-password" required minlength="10"></label>
      <p class="help">At least 10 characters with upper-case, lower-case and a number.</p>
      <label>Confirm new password <input type="password" name="confirm" autocomplete="new-password" required></label>
      <button class="btn btn-primary btn-lg" type="submit">Change password</button>
    </form>
  <% } %>
</section>
<%- include('partials/foot') %>
