<%- include('partials/head') %>
<h1>Hello, <%= currentUser.name.split(' ')[0] %></h1>
<% var steps = [
  { done: complete, label: 'Complete your profile', href: '/profile', cta: 'Open profile' },
  { done: counts.saved > 0 || counts.tracked > 0, label: 'Save your first scholarship', href: '/scholarships', cta: 'Find scholarships' },
  { done: counts.progressed > 0, label: 'Update an application status (for example Preparing)', href: '/applications', cta: 'Open tracker' },
  { done: counts.applied > 0, label: 'Mark an application as Applied', href: '/applications', cta: 'Open tracker' }
]; var doneN = steps.filter(function(x){ return x.done; }).length; %>
<% if (doneN < steps.length) { %>
  <div class="card callout checklist">
    <div class="page-head"><h2>Get started <span class="muted small">· <%= doneN %> of <%= steps.length %> done</span></h2></div>
    <div class="bar-track" role="progressbar" aria-valuemin="0" aria-valuemax="<%= steps.length %>" aria-valuenow="<%= doneN %>"><div class="bar-fill pct-<%= Math.round(doneN / steps.length * 4) * 25 %>" data-pct="<%= Math.round(doneN / steps.length * 4) * 25 %>"></div></div>
    <ul class="todo">
      <% steps.forEach(function(st){ %><li class="<%= st.done ? 'done' : '' %>"><span class="tick" aria-hidden="true"><%= st.done ? '✔' : '○' %></span> <span><%= st.label %><% if (st.done) { %><span class="sr"> (done)</span><% } %></span><% if (!st.done) { %> <a class="btn small" href="<%= st.href %>"><%= st.cta %></a><% } %></li><% }) %>
    </ul>
  </div>
<% } %>
<section class="stats" aria-label="Your progress">
  <div class="stat"><b><%= counts.saved %></b><span>Saved</span></div>
  <div class="stat"><b><%= counts.tracked %></b><span>Tracked</span></div>
  <div class="stat"><b><%= counts.applied %></b><span>Applied</span></div>
</section>
<div class="grid-2">
  <section>
    <h2>Upcoming deadlines</h2>
    <% if (!upcoming.length) { %><p class="muted">Nothing saved yet. <a href="/scholarships">Find scholarships</a> and save the ones you like.</p><% } %>
    <ul class="list">
      <% upcoming.forEach(function(s){ %>
        <li><a href="/scholarships/<%= s.id %>"><%= s.title %></a><span class="chip chip-<%= urgency(s.deadline) %>"><%= daysLabel(s.deadline) %></span></li>
      <% }) %>
    </ul>
  </section>
  <section>
    <h2>Latest alerts</h2>
    <% if (!notes.length) { %><p class="muted">No alerts yet. Reminders appear here before your saved deadlines.</p><% } %>
    <ul class="list">
      <% notes.forEach(function(n){ %><li class="<%= n.is_read ? '' : 'unread' %>"><a href="<%= n.link || '/notifications' %>"><%= n.message %></a></li><% }) %>
    </ul>
    <p><a href="/notifications">All alerts →</a></p>
  </section>
</div>
<section>
  <h2>Recommended for you</h2>
  <% if (!recs.length) { %><p class="muted"><%= complete ? 'No strong matches right now. Check back as new scholarships are added.' : 'Complete your profile to see personalised recommendations.' %></p><% } %>
  <div class="cards">
    <% recs.forEach(function(r){ %><%- include('partials/card', { s: r.s, m: r.m }) %><% }) %>
  </div>
  <% if (recs.length) { %><p><a href="/scholarships">Browse all scholarships →</a></p><% } %>
</section>
<%- include('partials/foot') %>
