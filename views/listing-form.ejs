<%- include('partials/head') %>
<section class="narrow wide">
  <h1><%= title %></h1>
  <%- include('partials/errors', { errors }) %>
  <form method="post" action="<%= action %>" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Scholarship title <input name="title" value="<%= s.title || '' %>" required maxlength="160"></label>
    <label>Provider / organisation <input name="provider" value="<%= s.provider || '' %>" required maxlength="160"></label>
    <label>Description <textarea name="description" rows="5" required maxlength="3000"><%= s.description || '' %></textarea></label>
    <label>Eligibility requirements <textarea name="eligibility" rows="3" required maxlength="2000"><%= s.eligibility || '' %></textarea></label>
    <div class="grid-3">
      <label>Education level <select name="education_level"><%- include('partials/options', { list: ['Any'].concat(levels), selected: s.education_level || 'Any' }) %></select></label>
      <label>Field of study <select name="field_of_study"><%- include('partials/options', { list: fields, selected: s.field_of_study || 'Any' }) %></select></label>
      <label>Country <select name="country"><%- include('partials/options', { list: countries, selected: s.country || 'Any' }) %></select></label>
    </div>
    <label class="check"><input type="checkbox" name="need_based" value="1" <%= s.need_based ? 'checked' : '' %>> Need-based scholarship</label>
    <label>Award value <input name="award_value" value="<%= s.award_value || '' %>" maxlength="120" placeholder="e.g. Full tuition"></label>
    <div class="grid-2">
      <label>Deadline type
        <select name="deadline_type">
          <option value="fixed" <%= (s.deadline_type || 'fixed') === 'fixed' ? 'selected' : '' %>>A fixed date</option>
          <option value="annual" <%= s.deadline_type === 'annual' ? 'selected' : '' %>>Opens every year (date not yet published)</option>
          <option value="rolling" <%= s.deadline_type === 'rolling' ? 'selected' : '' %>>Rolling (apply any time)</option>
        </select>
      </label>
      <label>Deadline date (fixed only) <input type="date" name="deadline" value="<%= s.deadline && s.deadline !== '2099-12-31' ? s.deadline : '' %>"></label>
    </div>
    <label>Country where you will study (optional; separate several with commas) <input name="study_in" value="<%= s.study_in || '' %>" maxlength="160" placeholder="e.g. Costa Rica, Germany"></label>
    <label>Timing note <input name="deadline_note" value="<%= s.deadline_note || '' %>" maxlength="300" placeholder="e.g. Applications open each September; check the official page"></label>
    <label>Official application link <input type="url" name="application_url" value="<%= s.application_url || '' %>" required maxlength="500" placeholder="https://…"></label>
    <label>Official page where these facts were checked (optional) <input type="url" name="source_url" value="<%= s.source_url || '' %>" maxlength="500" placeholder="https://…"></label>
    <label>How to apply (optional) <textarea name="instructions" rows="3" maxlength="2000"><%= s.instructions || '' %></textarea></label>
    <p>
      <button class="btn btn-primary btn-lg" type="submit">Save</button>
      <a class="btn btn-ghost" href="<%= cancel %>">Cancel</a>
    </p>
  </form>
</section>
<%- include('partials/foot') %>
