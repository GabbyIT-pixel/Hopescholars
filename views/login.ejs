<%- include('partials/head') %>
<section class="narrow">
  <h1>Welcome back</h1>
  <p class="muted">Log in to see your matches, saved scholarships and deadlines.</p>
  <%- include('partials/errors', { errors }) %>
  <% if (googleEnabled) { %>
    <a class="btn btn-google btn-lg block" href="/auth/google"><%- include('partials/google-icon') %> Continue with Google</a>
  <% } else { %>
    <a class="btn btn-google btn-lg block google-off" href="/auth/google"><%- include('partials/google-icon') %> Continue with Google</a>
    <p class="google-note">Google sign-in is not switched on for this site yet (the site owner must add Google credentials). Use your email below.</p>
  <% } %>
  <p class="divider"><span>or log in with email</span></p>
  <form method="post" action="/login" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Email address <input id="email" type="email" name="email" value="<%= form.email || '' %>" autocomplete="username" required autofocus></label>
    <label>Password <span class="pw"><input id="password" type="password" name="password" autocomplete="current-password" required></span></label>
    <button class="btn btn-primary btn-lg" type="submit">Log in</button>
  </form>
  <% if (demoMode) { %>
    <div class="card demo-box">
      <h2>Try the demo</h2>
      <p class="small muted">Tap a role to fill the form, then press Log in.</p>
      <div class="row-actions">
        <button class="btn small" type="button" data-fill-email="student@hopescholar.demo" data-fill-password="Student#2026demo">Student</button>
        <button class="btn small" type="button" data-fill-email="provider@hopescholar.demo" data-fill-password="Provider#2026demo">Scholarship provider</button>
      </div>
    </div>
  <% } %>
  <p><a href="/forgot">Forgot your password?</a></p>
  <p>New here? <a href="/register">Create an account</a></p>
</section>
<%- include('partials/foot') %>
