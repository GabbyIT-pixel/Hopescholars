# Copy to .env (never commit it) or set these in your hosting dashboard.
NODE_ENV=production
PORT=3000
# Required in production: password for the administrator account created on first start.
# Use 12+ characters with upper-case, lower-case and a number.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@yourdomain.org
# Optional: where the SQLite file lives (use a persistent disk in production).
DB_PATH=./data/hopescholar.db
# Demo switches. Leave both off for real student data.
SEED_DEMO=false
DEMO_MODE=false
