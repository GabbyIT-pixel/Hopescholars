# Copy to .env (never commit it) or set these in your hosting dashboard.
NODE_ENV=production
PORT=3000
# Required in production: password for the administrator account created on first start.
# Use 12+ characters with upper-case, lower-case and a number.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@yourdomain.org
# Optional: where the SQLite file lives (use a persistent disk in production).
DB_PATH=./data/hopescholar.db
# Demo switches. Leave both off for real student data.
SEED_DEMO=false
DEMO_MODE=false

# --- Optional: Sign in with Google (button appears only when both are set) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials (type: Web application)
# Authorised redirect URI:  <PUBLIC_URL>/auth/google/callback   e.g. http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of the site. On Render this is filled in automatically (RENDER_EXTERNAL_URL).
PUBLIC_URL=http://localhost:3000

# --- Optional: AI-written help desk answers (otherwise the built-in knowledge base is used) ---
ANTHROPIC_API_KEY=
HELPDESK_MODEL=claude-sonnet-5-5

# --- Optional: email (password-reset links and deadline reminders). All four must be set. ---
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hope Scholar <you@gmail.com>
